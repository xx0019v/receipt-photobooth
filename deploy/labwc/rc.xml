<?xml version="1.0"?>
<!--
  labwc config for the kiosk Pi. Install: cp deploy/labwc/rc.xml ~/.config/labwc/
  then `labwc -\-reconfigure` (or send SIGHUP to labwc).

  mouseEmulation MUST stay "no": with "yes" (which Raspberry Pi OS setup tools
  like to write) every touch becomes a mouse event - taps still click, but
  swipes turn into mouse drags and native touch scrolling dies across the UI.
-->
<openbox_config xmlns="http://openbox.org/3.4/rc">
	<touch deviceName="11-0038 generic ft5x06 (00)" mapToOutput="DSI-2" mouseEmulation="no"/>
</openbox_config>
