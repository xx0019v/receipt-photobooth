# systemd unit for the booth backend (Raspberry Pi 5).
# Install:
#   sudo cp deploy/booth-backend.service /etc/systemd/system/
#   sudo systemctl enable --now booth-backend
[Unit]
Description=THE RECEIPT photobooth backend
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/receipt-photobooth/backend
Environment=CAMERA_DRIVER=picamera2
Environment=PRINTER_DRIVER=escpos
Environment=PRINTER_WIDTH_DOTS=384
# Set to the IDs from `lsusb` for your printer:
Environment=PRINTER_USB_VENDOR=0x0416
Environment=PRINTER_USB_PRODUCT=0x5011
Environment=BOOTH_DATA_DIR=/home/pi/booth-data
ExecStart=/home/pi/receipt-photobooth/backend/.venv/bin/uvicorn booth.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
